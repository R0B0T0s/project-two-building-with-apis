# Copy this file to .env and fill in the values. Never commit .env.

# Django secret key. Generate one with:
#   uv run python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=

# True for local development, False otherwise.
DEBUG=True

# TMDB "API Read Access Token" (themoviedb.org > Settings > API).
TMDB_READ_TOKEN=
